{
  // Boot profile used to select the transport implementation.
  // Release builds use only real hardware serial ports.
  "profile": "Hardware",

  // File name for persisted game settings.
  // This file is resolved relative to hostsettings.json.
  "gameSettingsFileName": "settings.json",

  // Controls whether the Debug tab is visible in the WPF application.
  "showDebugTab": false,

  // Default single-byte encoding used by the CMD utility for custom payload sending.
  // Examples: "windows-1251", "cp866", "koi8-r", "us-ascii"
  "payloadEncoding": "windows-1251",

  "runtime": {
    // Shared timing loop interval for game clock, shot clock, and buzzer timing.
    "timingIntervalMilliseconds": 100,

    // Packet publish interval in milliseconds.
    "publishIntervalMilliseconds": 50
  }
}
