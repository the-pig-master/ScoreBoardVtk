<UserControl x:Class="ScoreBoardVtk.Wpf.Views.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <Grid DataContext="{Binding Workspace}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="540" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="COM port" Style="{StaticResource FieldCaptionStyle}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Width="200"
                          Height="36"
                          ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="Refresh Ports"
                        Width="130"
                        Command="{Binding RefreshPortsCommand}"
                        Style="{StaticResource DeskButtonStyle}" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        Width="130"
                        Command="{Binding TogglePortCommand}"
                        Style="{StaticResource PortToggleButtonStyle}" />
                <TextBlock Grid.Row="0"
                           Grid.Column="4"
                           Text="{Binding HostClock, StringFormat=Host clock: {0:HH:mm:ss}}"
                           Style="{StaticResource HostClockTextStyle}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Device time" Style="{StaticResource FieldCaptionStyle}" VerticalAlignment="Center" />
                <Button Grid.Row="1"
                        Grid.Column="1"
                        Content="Sync Device Time"
                        Width="160"
                        Command="{Binding SyncTimeCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Game mode" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Width="300"
                              Height="36"  HorizontalAlignment="Left"
                              ItemsSource="{Binding GameModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedGameMode}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="Font mode" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Width="300"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedFontMode}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Timer direction" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Width="300"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding TimerDirections}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTimerDirection}" />
                </StackPanel>

              
                
                    <Button Content="Apply"  Grid.Row="0" Grid.Column="3"
                           
                            Command="{Binding ApplySettingsCommand}"
                            Style="{StaticResource DeskButtonStyle}" />

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Main timer preset" Style="{StaticResource FieldCaptionStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="90" Height="36" ItemsSource="{Binding PresetMinuteOptions}" SelectedItem="{Binding PresetMinutes}" />
                        <ComboBox Width="90" Height="36" Margin="12,0,0,0" ItemsSource="{Binding PresetSecondOptions}" SelectedItem="{Binding PresetSeconds}" />
                        <ComboBox Width="90" Height="36" Margin="12,0,0,0" ItemsSource="{Binding PresetTenthsOptions}" SelectedItem="{Binding PresetTenths}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Overtime preset" Style="{StaticResource FieldCaptionStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="90" Height="36" ItemsSource="{Binding PresetMinuteOptions}" SelectedItem="{Binding OvertimePresetMinutes}" />
                        <ComboBox Width="90" Height="36" Margin="12,0,0,0" ItemsSource="{Binding PresetSecondOptions}" SelectedItem="{Binding OvertimePresetSeconds}" />
                        <ComboBox Width="90" Height="36" Margin="12,0,0,0" ItemsSource="{Binding PresetTenthsOptions}" SelectedItem="{Binding OvertimePresetTenths}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Main buzzer, sec" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Width="180"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding SignalDurationOptions}"
                              SelectedItem="{Binding MainSignalDurationSeconds}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3">
                    <TextBlock Text="24 sec buzzer, tenths" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Width="220"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ShotClockSignalOptions}"
                              SelectedItem="{Binding ShotClockSignalDurationTenths}" />
                </StackPanel>

                <CheckBox Grid.Row="2"
                          Grid.Column="0"
                          Content="Basketball fouls cap at 5"
                          IsChecked="{Binding CountFoulsToFive}"
                          FontSize="14"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsBasketballOnlyCheckBoxStyle}" />

                <CheckBox Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Content="Auto-start shot clock after 24 / 14 reset"
                          IsChecked="{Binding AutoStartShotClock}"
                          FontSize="14"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsBasketballOnlyCheckBoxStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Payload Preview"
                           Style="{StaticResource PayloadHeaderTextStyle}"
                           Margin="0,0,0,12" />
                <TextBox Height="350"
                         Text="{Binding CurrentSnapshot.PayloadText, Mode=OneWay, StringFormat=AT+GD{0}}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
