<UserControl x:Class="ScoreBoardVtk.Wpf.Views.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <Grid DataContext="{Binding Workspace}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource SettingsComPort}"
                           Style="{StaticResource FieldCaptionStyle}"
                           VerticalAlignment="Center" />

                <ComboBox Grid.Column="1"
                          Width="200" Margin="16 0 16 0"
                          ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="4"
                           Margin="16 0 0 0"
                           Text="{DynamicResource SettingsLanguage}"
                           Style="{StaticResource FieldCaptionStyle}"
                           VerticalAlignment="Center" />

                <ComboBox Grid.Column="5"
                          Width="160"
                          Margin="16 0 0 0"
                          HorizontalAlignment="Left"
                          ItemsSource="{Binding UiLanguages}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedUiLanguage}"
                          VerticalAlignment="Center" />

                <Button Grid.Column="2"
                        Content="{DynamicResource SettingsRefreshPorts}"
                        Width="130"
                        Margin="0 0 16 0"
                        Command="{Binding RefreshPortsCommand}"
                        VerticalAlignment="Center"
                        Style="{StaticResource DeskButtonStyle}" />

                <Button Grid.Column="3"
                        Width="130"
                        Command="{Binding TogglePortCommand}"
                        VerticalAlignment="Center"
                        Style="{StaticResource PortToggleButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsGameMode}" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Grid.Row="1"
                              Width="260"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding GameModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedGameMode}" />
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsFontMode}" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Grid.Row="1"
                              Width="260"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedFontMode}" />
                </Grid>

                <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsTimerDirection}" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Grid.Row="1"
                              Width="260"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding TimerDirections}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedTimerDirection}" />
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,16,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsMainTimerPreset}" Style="{StaticResource FieldCaptionStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding PresetMinuteOptions}"
                                  SelectedItem="{Binding PresetMinutes}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding PresetSecondOptions}"
                                  SelectedItem="{Binding PresetSeconds}" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding PresetTenthsOptions}"
                                  SelectedItem="{Binding PresetTenths}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsOvertimePreset}" Style="{StaticResource FieldCaptionStyle}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding PresetMinuteOptions}"
                                  SelectedItem="{Binding OvertimePresetMinutes}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding PresetSecondOptions}"
                                  SelectedItem="{Binding OvertimePresetSeconds}" />
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding PresetTenthsOptions}"
                                  SelectedItem="{Binding OvertimePresetTenths}" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2" Margin="0,16,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource SettingsMainBuzzerSeconds}" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SignalDurationOptions}"
                              SelectedItem="{Binding MainSignalDurationSeconds}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource SettingsShotClockBuzzerTenths}" Style="{StaticResource FieldCaptionStyle}" />
                    <ComboBox Grid.Row="1" Grid.Column="2"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding ShotClockSignalOptions}"
            SelectedItem="{Binding ShotClockSignalDurationTenths}" />
                </Grid>


                <CheckBox Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          Content="{DynamicResource SettingsBasketballFoulsCapAt5}"
                          IsChecked="{Binding CountFoulsToFive}"
                          FontSize="14"
                          FontWeight="SemiBold"
                          Margin="0,18,0,0"
                          VerticalAlignment="Center"
                          Style="{StaticResource SettingsBasketballOnlyCheckBoxStyle}" />

                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="{DynamicResource SettingsApply}"
                        Width="130"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding ApplySettingsCommand}"
                        Style="{StaticResource DeskButtonStyle}" />
                <Grid Grid.Row="3" Grid.ColumnSpan="4" Margin="0 16 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource SettingsKeyboardShortcuts}"
                Style="{StaticResource PayloadHeaderTextStyle}"
                Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1"
                Text="{Binding KeyboardShortcutCaptureText}"
                Style="{StaticResource FieldCaptionStyle}"
                Margin="0,0,0,12" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding KeyboardShortcutBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="360" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                    Text="{Binding Label}"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold" />

                                        <TextBlock Grid.Column="1"
                                    Text="{Binding AssignedKeyDisplay}"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14" />

                                        <Button Grid.Column="2"
                                 Content="{Binding AssignButtonText}"
                                 Command="{Binding BeginAssignCommand}"
                                 Width="120"
                                 Style="{StaticResource DeskButtonStyle}" />

                                        <Button Grid.Column="3"
                                 Content="{Binding ClearButtonText}"
                                 Command="{Binding ClearCommand}"
                                 Width="100"
                                 Style="{StaticResource DeskButtonStyle}"
                                 Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
