<UserControl x:Class="ScoreBoardVtk.Wpf.Views.DebugTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <Grid DataContext="{Binding Workspace}" Margin="16">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0"
                          Content="{DynamicResource DebugModeToggle}"
                          IsChecked="{Binding IsDebugMode}"
                          Style="{StaticResource MutedCheckBoxStyle}" />

                <TextBlock Grid.Row="1"
                           Margin="0,16,0,8"
                           Text="{DynamicResource DebugPayload}"
                           Style="{StaticResource FieldCaptionStyle}" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="40"
                             Text="{Binding ManualPayloadText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             Style="{StaticResource InputTextBoxStyle}" />

                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Content="{DynamicResource DebugSend}"
                            Command="{Binding SendManualPayloadCommand}"
                            IsEnabled="{Binding CanSendManualPayload}"
                            Style="{StaticResource DeskButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
