<Window x:Class="ScoreBoardVtk.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ScoreBoardVtk.Wpf.Views"
        mc:Ignorable="d"
        Title="ScoreBoardVtk"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="600"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Margin="16,16,16,0" FontSize="16">
            <TabItem Header="{DynamicResource MainTabGame}">
                <views:GameTabView DataContext="{Binding GameTab}" />
            </TabItem>

            <TabItem Header="{DynamicResource MainTabSettings}">
                <views:SettingsTabView DataContext="{Binding SettingsTab}" />
            </TabItem>
        </TabControl>

        <views:ShellStatusBarView Grid.Row="1" DataContext="{Binding Workspace}" />
    </Grid>
</Window>
