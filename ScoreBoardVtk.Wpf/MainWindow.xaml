<Window x:Class="ScoreBoardVtk.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sports Scoreboard Modern"
        Width="1320"
        Height="860"
        MinWidth="1200"
        MinHeight="740"
        Background="#EEF3F7">
    <Window.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8E0E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8E0E7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#586069" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <LinearGradientBrush x:Key="ScoreboardShellBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#DCE4EA" Offset="0" />
            <GradientStop Color="#C7D2DB" Offset="0.45" />
            <GradientStop Color="#B4C0CA" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScoreboardFaceBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#091015" Offset="0" />
            <GradientStop Color="#0B1117" Offset="0.55" />
            <GradientStop Color="#06090D" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConsoleCardBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#EEF3F7" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="GameDeskBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ConsoleCardBrush}" />
            <Setter Property="BorderBrush" Value="#D5DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="DeskButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#23303A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CDD7E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6F9" />
                    <Setter Property="BorderBrush" Value="#93A6B7" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E8EEF4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentDeskButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeskButtonStyle}">
            <Setter Property="Background" Value="#E15F4A" />
            <Setter Property="BorderBrush" Value="#F2947E" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="WarningDeskButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeskButtonStyle}">
            <Setter Property="Background" Value="#B88A1A" />
            <Setter Property="BorderBrush" Value="#E2BF63" />
            <Setter Property="Foreground" Value="#101316" />
        </Style>

        <Style x:Key="DisplayLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9DABB7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DisplayValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#121A20" />
            <Setter Property="BorderBrush" Value="#25313A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#EEF3F7" />

        <TabControl Grid.Row="0"
                    Margin="18"
                    Background="Transparent">
            <TabItem Header="Game">
               
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Viewbox Stretch="Uniform">
                        <Border Grid.Row="0"
                                Background="{StaticResource ScoreboardShellBrush}"
                                BorderBrush="#33424F"
                                BorderThickness="1.5"
                                CornerRadius="24"
                                Padding="12">
                            <Grid>
                                <Border Background="{StaticResource ScoreboardFaceBrush}"
                                        CornerRadius="20"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.35*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource StatusChipStyle}">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Margin="0,0,8,0"
                                                             Fill="{Binding MainSignalBrush}"
                                                             Stroke="#677786"
                                                             StrokeThickness="1" />
                                                    <TextBlock Text="MAIN SIGNAL"
                                                               Foreground="#D5DDE5"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource StatusChipStyle}">
                                                <TextBlock Text="{Binding SelectedGameMode.Label, TargetNullValue=Basketball}"
                                                           Foreground="#D5DDE5"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource StatusChipStyle}">
                                                <TextBlock Text="{Binding PresetStatusText}"
                                                           Foreground="#D5DDE5"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <Border Grid.Column="3"
                                                    Style="{StaticResource StatusChipStyle}">
                                                <TextBlock Text="{Binding PortStatusText}"
                                                           Foreground="#D5DDE5"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3.2*" />
                                                <ColumnDefinition Width="2.35*" />
                                                <ColumnDefinition Width="3.2*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    Background="#090E12"
                                                    BorderBrush="#253039"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="HOME"
                                                               Style="{StaticResource DisplayLabelStyle}" />
                                                    <Viewbox Grid.Row="1"
                                                             Stretch="Uniform"
                                                             Margin="0,8,0,4">
                                                        <TextBlock Text="{Binding ScoreAText}"
                                                                   Style="{StaticResource DisplayValueStyle}"
                                                                   FontSize="140"
                                                                   Foreground="#FF614B" />
                                                    </Viewbox>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding PenaltyLabelText}"
                                                                   Style="{StaticResource DisplayLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding PenaltyAText}"
                                                                   Style="{StaticResource DisplayValueStyle}"
                                                                   FontSize="38"
                                                                   Foreground="#A8FF7A"
                                                                   Margin="12,0,0,0" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Column="1"
                                                  Margin="0,0,10,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        Background="#0C1318"
                                                        BorderBrush="#253039"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="12"
                                                        Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="PERIOD / SET"
                                                                       Style="{StaticResource DisplayLabelStyle}" />
                                                            <TextBlock Text="{Binding PeriodText}"
                                                                       Style="{StaticResource DisplayValueStyle}"
                                                                       FontSize="54"
                                                                       Foreground="#A8FF7A"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    Margin="14,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="SHOT READY"
                                                                       Style="{StaticResource DisplayLabelStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <Ellipse Width="16"
                                                                     Height="16"
                                                                     Margin="0,6,0,0"
                                                                     Fill="{Binding ShotClockBrush}"
                                                                     Stroke="#677786"
                                                                     StrokeThickness="1" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="1"
                                                        Background="#090E12"
                                                        BorderBrush="#253039"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="12">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="GAME CLOCK"
                                                                   Style="{StaticResource DisplayLabelStyle}"
                                                                   HorizontalAlignment="Center" />
                                                        <Viewbox Stretch="Uniform"
                                                                 Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding MainClockText}"
                                                                       Style="{StaticResource DisplayValueStyle}"
                                                                       FontSize="90"
                                                                       Foreground="#FFD05A" />
                                                        </Viewbox>
                                                    </StackPanel>
                                                </Border>

                                                <Grid Grid.Row="2"
                                                      Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            Background="#2A2108"
                                                            BorderBrush="#6D5520"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12">
                                                        <StackPanel>
                                                            <TextBlock Text="SHOT CLOCK"
                                                                       Style="{StaticResource DisplayLabelStyle}"
                                                                       Foreground="#EACD7A"
                                                                       HorizontalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding ShotClockSecondsText}"
                                                                           Style="{StaticResource DisplayValueStyle}"
                                                                           FontSize="56"
                                                                           Foreground="#FFD05A" />
                                                                <TextBlock Text="{Binding ShotClockTenthsText}"
                                                                           Style="{StaticResource DisplayValueStyle}"
                                                                           FontSize="24"
                                                                           Foreground="#FFD05A"
                                                                           VerticalAlignment="Bottom"
                                                                           Margin="3,0,0,4" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1"
                                                            Background="#0C1318"
                                                            BorderBrush="#253039"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="12">
                                                        <StackPanel>
                                                            <TextBlock Text="SIGNALS"
                                                                       Style="{StaticResource DisplayLabelStyle}"
                                                                       HorizontalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        Margin="0,8,0,0">
                                                                <StackPanel Margin="0,0,12,0">
                                                                    <Ellipse Width="18"
                                                                             Height="18"
                                                                             Fill="{Binding MainSignalBrush}"
                                                                             Stroke="#677786"
                                                                             StrokeThickness="1" />
                                                                    <TextBlock Text="MAIN"
                                                                               Style="{StaticResource DisplayLabelStyle}"
                                                                               FontSize="11"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0" />
                                                                </StackPanel>
                                                                <StackPanel>
                                                                    <Ellipse Width="18"
                                                                             Height="18"
                                                                             Fill="{Binding ShotClockBrush}"
                                                                             Stroke="#677786"
                                                                             StrokeThickness="1" />
                                                                    <TextBlock Text="24"
                                                                               Style="{StaticResource DisplayLabelStyle}"
                                                                               FontSize="11"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>

                                            <Border Grid.Column="2"
                                                    Background="#090E12"
                                                    BorderBrush="#253039"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="GUEST"
                                                               Style="{StaticResource DisplayLabelStyle}"
                                                               HorizontalAlignment="Right" />
                                                    <Viewbox Grid.Row="1"
                                                             Stretch="Uniform"
                                                             Margin="0,8,0,4">
                                                        <TextBlock Text="{Binding ScoreBText}"
                                                                   Style="{StaticResource DisplayValueStyle}"
                                                                   FontSize="140"
                                                                   Foreground="#FF614B" />
                                                    </Viewbox>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding PenaltyBText}"
                                                                   Style="{StaticResource DisplayValueStyle}"
                                                                   FontSize="38"
                                                                   Foreground="#A8FF7A"
                                                                   Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding PenaltyLabelText}"
                                                                   Style="{StaticResource DisplayLabelStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Border Grid.Row="2"
                                                Background="#121A20"
                                                BorderBrush="#25313A"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="240" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="RUNNING TEXT"
                                                           Style="{StaticResource DisplayLabelStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RunningText}"
                                                           Foreground="#EDF3F7"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="10,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SystemMessageText}"
                                                           Style="{StaticResource DisplayLabelStyle}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Margin="8"
                                        BorderBrush="#4D5C69"
                                        BorderThickness="1"
                                        CornerRadius="24"
                                        Opacity="0.18"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Viewbox>
                    <Grid Grid.Row="1"
                              Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.55*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource GameDeskBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Home Console"
                                               Foreground="#22303A"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />

                                    <Grid Grid.Row="1"
                                          Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Score"
                                                   Style="{StaticResource DisplayLabelStyle}"
                                                   Foreground="#5B6874"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="+1"
                                                    Command="{Binding IncreaseScoreACommand}"
                                                    Style="{StaticResource AccentDeskButtonStyle}"
                                                    Margin="0,0,8,10" />
                                            <Button Grid.Column="1"
                                                    Content="-1"
                                                    Command="{Binding DecreaseScoreACommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0,0,0,10" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PenaltyLabelText}"
                                                   Style="{StaticResource DisplayLabelStyle}"
                                                   Foreground="#5B6874"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="+1"
                                                    Command="{Binding IncreasePenaltyACommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="-1"
                                                    Command="{Binding DecreasePenaltyACommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource GameDeskBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Text="Match Desk"
                                               Foreground="#22303A"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />

                                    <Button Grid.Row="1"
                                            Grid.Column="0"
                                            Content="{Binding GameClockButtonText}"
                                            Command="{Binding ToggleGameClockCommand}"
                                            Style="{StaticResource AccentDeskButtonStyle}"
                                            Margin="0,0,10,10" />
                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Stop"
                                            Command="{Binding StopGameClockCommand}"
                                            Style="{StaticResource DeskButtonStyle}"
                                            Margin="0,0,0,10" />
                                    <Button Grid.Row="2"
                                            Grid.Column="0"
                                            Content="Period / Set"
                                            Command="{Binding AdvancePeriodOrSetCommand}"
                                            Style="{StaticResource DeskButtonStyle}"
                                            Margin="0,0,10,10" />
                                    <Button Grid.Row="2"
                                            Grid.Column="1"
                                            Content="Reset"
                                            Command="{Binding ResetCommand}"
                                            Style="{StaticResource DeskButtonStyle}"
                                            Margin="0,0,0,10" />
                                    <Button Grid.Row="3"
                                            Grid.Column="0"
                                            Content="Signal"
                                            Style="{StaticResource WarningDeskButtonStyle}"
                                            PreviewMouseLeftButtonDown="SignalButton_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="SignalButton_OnPreviewMouseLeftButtonUp"
                                            LostMouseCapture="SignalButton_OnLostMouseCapture"
                                            Margin="0,0,10,0" />
                                    <Border Grid.Row="3"
                                            Grid.Column="1"
                                            Background="#111821"
                                            BorderBrush="#2D3944"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="LIVE"
                                                       Style="{StaticResource DisplayLabelStyle}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Fill="{Binding MainSignalBrush}"
                                                     Stroke="#677786"
                                                     StrokeThickness="1"
                                                     Margin="0,0,8,0" />
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Fill="{Binding ShotClockBrush}"
                                                     Stroke="#677786"
                                                     StrokeThickness="1" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource GameDeskBorderStyle}"
                                    IsEnabled="{Binding IsBasketballMode}">
                                <StackPanel>
                                    <TextBlock Text="Shot Clock Desk"
                                               Foreground="#22303A"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="24"
                                                Command="{Binding SetShotClock24Command}"
                                                Style="{StaticResource WarningDeskButtonStyle}"
                                                Margin="0,0,8,10" />
                                        <Button Grid.Column="1"
                                                Content="14"
                                                Command="{Binding SetShotClock14Command}"
                                                Style="{StaticResource WarningDeskButtonStyle}"
                                                Margin="0,0,0,10" />
                                    </Grid>

                                    <Button Content="{Binding ShotClockButtonText}"
                                            Command="{Binding ToggleShotClockCommand}"
                                            Style="{StaticResource DeskButtonStyle}" />

                                    <Border Background="#111821"
                                            BorderBrush="#2D3944"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="12,10"
                                            Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Current value"
                                                           Style="{StaticResource DisplayLabelStyle}" />
                                                <TextBlock Text="{Binding ShotClockSecondsText}"
                                                           Style="{StaticResource DisplayValueStyle}"
                                                           FontSize="34"
                                                           Foreground="#FFD05A"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <Ellipse Grid.Column="1"
                                                     Width="18"
                                                     Height="18"
                                                     Fill="{Binding ShotClockBrush}"
                                                     Stroke="#677786"
                                                     StrokeThickness="1"
                                                     VerticalAlignment="Center"
                                                     Margin="14,0,0,0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3"
                                    Style="{StaticResource GameDeskBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Guest Console"
                                               Foreground="#22303A"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12" />

                                    <Grid Grid.Row="1"
                                          Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Score"
                                                   Style="{StaticResource DisplayLabelStyle}"
                                                   Foreground="#5B6874"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="+1"
                                                    Command="{Binding IncreaseScoreBCommand}"
                                                    Style="{StaticResource AccentDeskButtonStyle}"
                                                    Margin="0,0,8,10" />
                                            <Button Grid.Column="1"
                                                    Content="-1"
                                                    Command="{Binding DecreaseScoreBCommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0,0,0,10" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PenaltyLabelText}"
                                                   Style="{StaticResource DisplayLabelStyle}"
                                                   Foreground="#5B6874"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    Content="+1"
                                                    Command="{Binding IncreasePenaltyBCommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0,0,8,0" />
                                            <Button Grid.Column="1"
                                                    Content="-1"
                                                    Command="{Binding DecreasePenaltyBCommand}"
                                                    Style="{StaticResource DeskButtonStyle}"
                                                    Margin="0" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Style="{StaticResource GameDeskBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="240" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Operator Message"
                                               Foreground="#22303A"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <CheckBox Content="Enable running text"
                                              IsChecked="{Binding RunningTextEnabled}"
                                              VerticalAlignment="Center"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="#5B6874"
                                              Margin="0,8,0,0" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Margin="14,0"
                                         Text="{Binding RunningText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="24"
                                         FontSize="15"
                                         Height="38"
                                         Padding="12,7"
                                         Background="#FFFFFF"
                                         Foreground="#22303A"
                                         BorderBrush="#CDD7E0"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center" />

                                <Border Grid.Column="2"
                                        Background="#111821"
                                        BorderBrush="#2D3944"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding PayloadStatusText}"
                                                       Foreground="#DDE6ED"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SystemMessageText}"
                                                       Style="{StaticResource DisplayLabelStyle}"
                                                       Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="MAIN"
                                                       Style="{StaticResource DisplayLabelStyle}"
                                                       HorizontalAlignment="Center" />
                                            <Ellipse Width="18"
                                                     Height="18"
                                                     Margin="0,6,0,10"
                                                     Fill="{Binding MainSignalBrush}"
                                                     Stroke="#677786"
                                                     StrokeThickness="1" />
                                            <TextBlock Text="24"
                                                       Style="{StaticResource DisplayLabelStyle}"
                                                       HorizontalAlignment="Center" />
                                            <Ellipse Width="18"
                                                     Height="18"
                                                     Margin="0,6,0,0"
                                                     Fill="{Binding ShotClockBrush}"
                                                     Stroke="#677786"
                                                     StrokeThickness="1" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
               
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,18"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="COM port"
                                           Style="{StaticResource FieldCaptionStyle}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          ItemsSource="{Binding AvailablePorts}"
                                          SelectedItem="{Binding SelectedPort}"
                                          Height="34"
                                          Style="{StaticResource InputStyle}" />
                                <Button Grid.Row="0"
                                        Grid.Column="2"
                                        Content="Refresh Ports"
                                        Command="{Binding RefreshPortsCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="10,0,10,10" />
                                <Button Grid.Row="0"
                                        Grid.Column="3"
                                        Content="{Binding PortButtonText}"
                                        Command="{Binding TogglePortCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,10,10" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="4"
                                           Text="{Binding HostClockText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2C3E50" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Device time"
                                           Style="{StaticResource FieldCaptionStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Content="Sync Device Time"
                                        Command="{Binding SyncTimeCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding SystemMessageText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Foreground="#586069"
                                           Margin="12,0,0,8" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,0,0,18"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,14,0">
                                    <TextBlock Text="Game mode" Style="{StaticResource FieldCaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding GameModes}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedGameMode}"
                                              Height="34"
                                              Style="{StaticResource InputStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,14,0">
                                    <TextBlock Text="Font mode" Style="{StaticResource FieldCaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding FontModes}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedFontMode}"
                                              Height="34"
                                              Style="{StaticResource InputStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,0,14,0">
                                    <TextBlock Text="Timer direction" Style="{StaticResource FieldCaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding TimerDirections}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedTimerDirection}"
                                              Height="34"
                                              Style="{StaticResource InputStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="3">
                                    <TextBlock Text="Apply preset" Style="{StaticResource FieldCaptionStyle}" />
                                    <Button Content="Apply"
                                            Command="{Binding ApplyTimerPresetCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,4,0,10"
                                            Padding="18,8" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            Margin="0,0,14,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Minutes" Style="{StaticResource FieldCaptionStyle}" />
                                        <ComboBox ItemsSource="{Binding PresetMinuteOptions}"
                                                  SelectedItem="{Binding PresetMinutes}"
                                                  Width="90"
                                                  Height="34"
                                                  Style="{StaticResource InputStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Seconds" Style="{StaticResource FieldCaptionStyle}" />
                                        <ComboBox ItemsSource="{Binding PresetSecondOptions}"
                                                  SelectedItem="{Binding PresetSeconds}"
                                                  Width="90"
                                                  Height="34"
                                                  Style="{StaticResource InputStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Tenths" Style="{StaticResource FieldCaptionStyle}" />
                                        <ComboBox ItemsSource="{Binding PresetTenthsOptions}"
                                                  SelectedItem="{Binding PresetTenths}"
                                                  Width="90"
                                                  Height="34"
                                                  Style="{StaticResource InputStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,14,0">
                                    <TextBlock Text="Main buzzer, sec" Style="{StaticResource FieldCaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding SignalDurationOptions}"
                                              SelectedItem="{Binding MainSignalDurationSeconds}"
                                              Height="34"
                                              Style="{StaticResource InputStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,14,0">
                                    <TextBlock Text="24 sec buzzer, tenths" Style="{StaticResource FieldCaptionStyle}" />
                                    <ComboBox ItemsSource="{Binding ShotClockSignalOptions}"
                                              SelectedItem="{Binding ShotClockSignalDurationTenths}"
                                              Height="34"
                                              Style="{StaticResource InputStyle}" />
                                </StackPanel>

                                <CheckBox Grid.Row="2"
                                          Grid.Column="0"
                                          Content="Basketball fouls cap at 5"
                                          IsChecked="{Binding CountFoulsToFive}"
                                          VerticalAlignment="Center"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          IsEnabled="{Binding IsBasketballMode}" />
                                <CheckBox Grid.Row="2"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Content="Auto-start shot clock after 24 / 14 reset"
                                          IsChecked="{Binding AutoStartShotClock}"
                                          VerticalAlignment="Center"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          IsEnabled="{Binding IsBasketballMode}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Payload Preview"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <TextBox Grid.Row="1"
                                         Text="{Binding PayloadPreviewText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         Padding="12" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Margin="20"
                            Style="{StaticResource CardBorderStyle}">
                        <TextBlock Text="{Binding AboutText}"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Foreground="#24303A" />
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Background="#10161D"
                BorderBrush="#2A333C"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PortStatusText}"
                           Foreground="#D7E0E8"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding PresetStatusText}"
                           Foreground="#D7E0E8"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding PayloadStatusText}"
                           Foreground="#D7E0E8"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3"
                           Text="{Binding SystemMessageText}"
                           Foreground="#9DA9B4"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
